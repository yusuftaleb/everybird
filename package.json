{
  "name": "everybird",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "lint": "eslint",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:stress": "STRESS=1 playwright test --project=stress-chromium --project=stress-webkit --workers=1",
    "stickers:serve": "node scripts/dev/serve-stickers.mjs",
    "stats": "tsx scripts/stats/report.ts",
    "data": "tsx scripts/build-data/copy-synonyms.ts && tsx scripts/build-data/build-species.ts && tsx scripts/build-data/build-names.ts && tsx scripts/build-data/build-groups.ts && tsx scripts/build-data/build-geo.ts && tsx scripts/build-data/build-stickers.ts && tsx scripts/build-data/link-index.ts"
  },
  "dependencies": {
    "@jsquash/webp": "1.5.0",
    "@phosphor-icons/react": "^2.1.10",
    "fflate": "^0.8.3",
    "flag-icons": "^7.6.0",
    "idb-keyval": "^6.3.0",
    "next": "16.4.6",
    "papaparse": "^5.7.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.18",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "20.19.43",
    "@types/papaparse": "^5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19",
    "d3-geo": "^3.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "4.163.0"
  }
}
