{
  "name": "everybird-stats-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The private analytics console served by workers/stats at /dashboard. Builds one self-contained HTML that page.generated.ts embeds.",
  "scripts": {
    "dev": "vite --port 5180 --strictPort --host 127.0.0.1",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build && node scripts/write-page.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "preview": "vite preview --port 5180 --strictPort --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "radix-ui": "^1.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
