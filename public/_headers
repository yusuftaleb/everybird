# Static assets on Cloudflare Workers (the Worker serves them before its own code runs, so next.config's headers() don't
# reach them). The same rules as next.config.ts's headers(), plus the immutable build chunks that Vercel sends. Vercel
# ignores this file. Keep the two in step.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
/icons/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/favicon.ico
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/og/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/buy-me-a-coffee.png
  Cache-Control: public, max-age=14400, must-revalidate
/*
  Referrer-Policy: strict-origin
